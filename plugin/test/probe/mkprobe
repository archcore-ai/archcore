#!/bin/sh
# Build a disposable probe tree for a live-session host verification run.
#
# See host-probe-protocol.spec for what the probes are and how results are
# recorded. This script only prepares the ground.
#
# The tree it makes:
#
#   <dest>/plugin-src/     copy of plugins/archcore with four guards wrapped
#   <dest>/probe-project/  the project the host session opens
#   <dest>/probe.log       every guard invocation, tab-separated
#
# Three properties are deliberate, and each one is a trap the first attempt at
# this protocol fell into:
#
#   * Nothing is written inside plugins/archcore. The wrappers go into the
#     COPY, so there is no cleanup step that can be forgotten and no probe
#     line that can reach a commit (hooks-validation-system.spec conformance
#     13 forbids exactly that).
#
#   * The manifests in the copy get a sentinel version. Hosts cache plugin
#     installs by version; a copy carrying the same version as an installed
#     build can be shadowed by that cache, and the session then reports on
#     someone else's tree. jtbd1-phase2-hardening-delegated.plan records a run
#     lost to precisely this — a missing hook read as a coverage gap when the
#     real cause was that the probe tree was never loaded.
#
#   * probe-project/ is a SIBLING of plugin-src/, never a child. bin/session-start
#     walks upward looking for plugin manifests and exits silently when it finds
#     one, so a project nested inside the plugin copy would kill P0 with no
#     output at all.

set -eu

REPO_ROOT=${REPO_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)}
PLUGIN_SRC="$REPO_ROOT/plugins/archcore"
SENTINEL_VERSION="0.0.0-probe"

# Guards with a wrapper. One per probe in the protocol; pre-tool-use serves
# P0, A, and A-d (write guard + code-alignment context live behind it in the
# CLI), post-tool-use serves B/C/D.
WRAPPED="session-start pre-tool-use post-tool-use"

usage() {
  cat <<'EOF'
usage: test/probe/mkprobe [destination]

Creates a probe tree (default: a fresh mktemp -d) and prints the paths and
environment needed to start a host session against it.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

DEST=${1:-$(mktemp -d "${TMPDIR:-/tmp}/archcore-probe.XXXXXX")}
mkdir -p "$DEST"
DEST=$(CDPATH='' cd -- "$DEST" && pwd)

[ -d "$PLUGIN_SRC" ] || { echo "mkprobe: no plugin at $PLUGIN_SRC" >&2; exit 1; }

PROBE_PLUGIN="$DEST/plugin-src"
PROBE_PROJECT="$DEST/probe-project"
PROBE_LOG="$DEST/probe.log"

rm -rf "$PROBE_PLUGIN" "$PROBE_PROJECT"
mkdir -p "$PROBE_PLUGIN" "$PROBE_PROJECT"
cp -R "$PLUGIN_SRC/." "$PROBE_PLUGIN/"
: > "$PROBE_LOG"

# --- Sentinel version in every manifest the copy carries -------------------
for _mf in "$PROBE_PLUGIN"/.claude-plugin/plugin.json \
           "$PROBE_PLUGIN"/.cursor-plugin/plugin.json \
           "$PROBE_PLUGIN"/.codex-plugin/plugin.json \
           "$PROBE_PLUGIN"/.plugin/plugin.json; do
  [ -f "$_mf" ] || continue
  _tmp="$_mf.probe-tmp"
  sed "s/\"version\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"version\": \"$SENTINEL_VERSION\"/" \
    "$_mf" > "$_tmp"
  mv "$_tmp" "$_mf"
done

# --- Wrap the guards -------------------------------------------------------
# The wrapper must be transparent: same stdout, same stderr, same exit status.
# A probe that turns green because the wrapper swallowed a failure is worse
# than no probe, so probe-wrapper.bats asserts transparency against every
# fixture in the suite.
for _script in $WRAPPED; do
  _path="$PROBE_PLUGIN/bin/$_script"
  [ -f "$_path" ] || { echo "mkprobe: missing $_path" >&2; exit 1; }
  mv "$_path" "$_path.real"
  cat > "$_path" <<'WRAPPER'
#!/bin/sh
# ARCHCORE_PROBE wrapper — generated by test/probe/mkprobe, never committed.
_self=$(basename "$0")
_dir=$(dirname "$0")
_log=${ARCHCORE_PROBE_LOG:-/dev/null}
_payload=$(cat)
printf '%s\t%s\t%s\t%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$_self" "${ARCHCORE_HOST:-?}" "$_payload" >> "$_log"
printf '%s' "$_payload" | "$_dir/$_self.real" "$@"
exit $?
WRAPPER
  chmod +x "$_path"
done

# --- Probe project ---------------------------------------------------------
mkdir -p "$PROBE_PROJECT/src/probe" "$PROBE_PROJECT/.archcore/probe"
cat > "$PROBE_PROJECT/.archcore/probe/context.rule.md" <<'EOF'
---
title: "Probe rule for src/probe"
status: accepted
---

Everything under src/probe/ follows this rule. Probe A is confirmed when a
source edit there surfaces this document.
EOF
# The CLI's settings parser requires "sync". A file without it makes every
# session-start recap open with `invalid .archcore/settings.json`, which
# degrades P0 into a judgement call about whether the tree loaded or the
# project is simply broken. Keep this in step with `archcore init` output.
cat > "$PROBE_PROJECT/.archcore/settings.json" <<'EOF'
{ "sync": "none" }
EOF
(cd "$PROBE_PROJECT" && git init -q 2>/dev/null || true)

cat <<EOF
Probe tree ready.

  plugin copy   $PROBE_PLUGIN
  project       $PROBE_PROJECT
  log           $PROBE_LOG
  version       $SENTINEL_VERSION  (must appear in the host's plugin listing;
                                    if it does not, the session is served by a
                                    cache and no row may be recorded — P0)

Start the session with the log wired up, for example:

  export ARCHCORE_PROBE_LOG="$PROBE_LOG"
  claude   --plugin-dir "$PROBE_PLUGIN" -C "$PROBE_PROJECT"
  cursor   --plugin-dir "$PROBE_PLUGIN" -C "$PROBE_PROJECT"
  copilot  --plugin-dir "$PROBE_PLUGIN" -C "$PROBE_PROJECT"

Then, in order: P0 (check the log has a session-start line BEFORE prompting),
A, A-d, B, C, D. Remove the tree when done: rm -rf "$DEST"

On Copilot, P0 has an extra way to fail that is NOT a coverage gap: if the
session prints "archcore: plugin root unresolved", the host injected none of
the plugin-root variables the hook config probes, so no guard ran at all.
GitHub documents no plugin-root variable for hook processes and hooks only for
Copilot CLI and cloud agent -- not VS Code (copilot-adapter-design.adr). Record
which load path produced it; per the protocol, do NOT record a row for that run.
EOF
